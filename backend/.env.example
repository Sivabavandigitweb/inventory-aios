# Local backend configuration. Copy to .env and replace values as needed.
INVENTORY_ENVIRONMENT=development
INVENTORY_DEBUG=false
INVENTORY_API_PREFIX=/api/v1
INVENTORY_API_VERSION=v1
INVENTORY_FRONTEND_ORIGIN=http://localhost:5173
INVENTORY_LOG_LEVEL=INFO
INVENTORY_APP_VERSION=0.1.0

# Dedicated local Inventory AIOS development database only.
# Replace <password> locally; never commit the resulting .env file.
INVENTORY_DATABASE_URL=postgresql+psycopg://inventory_aios_app:<runtime-password>@localhost:5432/inventory_aios_dev
INVENTORY_DATABASE_POOL_SIZE=5
INVENTORY_DATABASE_MAX_OVERFLOW=10
INVENTORY_DATABASE_POOL_PRE_PING=true

# Reserved for later approved integrations; do not add secrets here.

# INVENTORY_GROK_API_KEY=
